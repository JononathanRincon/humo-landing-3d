# Conexión a Postgres (Supabase, Neon o Railway). En Supabase usa la "Transaction pooler" (puerto 6543).
DATABASE_URL=postgres://usuario:clave@host:6543/postgres
# Secreto para firmar la sesión del panel. Cualquier texto largo y aleatorio.
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Lo crea Vercel al conectar un Blob store al proyecto (fotos y videos).
BLOB_READ_WRITE_TOKEN=
